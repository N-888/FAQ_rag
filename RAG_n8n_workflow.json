      "parameters": {
        "httpMethod": "POST",
        "path": "rag-question",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "f1a7c5e0-0002-0000-0000-000000000002",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-200, 600],
      "webhookId": "rag-webhook-001"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ngapi.sberbank.ru/prod/tokens/v3/oauth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.GIGACHAT_AUTH_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "scope",
              "value": "GIGACHAT_API_PERS"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "f1a7c5e0-0002-0000-0000-000000000003",
      "name": "Токен GigaChat (для вопроса)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [50, 600]
    },
    {
      "parameters": {
        "jsCode": "const query = $input.first().json.body?.query || $input.first().json.query || 'тест';\nconst token = $('Токен GigaChat (для вопроса)').first().json.body.access_token;\n\nreturn [{ json: { query: query, token: token } }];"
      },
      "id": "f1a7c5e0-0002-0000-0000-000000000004",
      "name": "Подготовка",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [300, 600]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ngapi.sberbank.ru/prod/v1/embeddings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ input: $json.query, model: 'Embeddings' }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "f1a7c5e0-0002-0000-0000-000000000005",
      "name": "Эмбеддинг вопроса",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [550, 600]
    },
    {
      "parameters": {
        "jsCode": "const vector = $input.first().json.body?.data?.[0]?.embedding;\nconst query = $('Подготовка').first().json.query;\n\nreturn [{ json: { vector: vector, query: query } }];"
      },
      "id": "f1a7c5e0-0002-0000-0000-000000000006",
      "name": "Собрать запрос",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 600]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $env.QDRANT_ENDPOINT }}/collections/{{ $env.QDRANT_COLLECTION }}/points/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "={{ $env.QDRANT_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ vector: $json.vector, top: 4, with_payload: true }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "f1a7c5e0-0002-0000-0000-000000000007",
      "name": "Поиск в Qdrant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 600]
    },
    {
      "parameters": {
        "jsCode": "const results = $input.first().json.body?.result;\nconst query = $('Собрать запрос').first().json.query;\n\nif (!results || results.length === 0) {\n  return [{ json: { context: 'Информация не найдена', query: query, found: false } }];\n}\n\nconst ctx = results.map((r, i) => `[${i+1}] ${r.payload?.text}`).join('\\n\\n');\n\nreturn [{ json: { context: ctx, query: query, found: true } }];"
      },
      "id": "f1a7c5e0-0002-0000-0000-000000000008",
      "name": "Подготовить контекст",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 600]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ answer: $json.context, query: $json.query, found: $json.found }) }}",
        "options": {}
      },
      "id": "f1a7c5e0-0002-0000-0000-000000000009",
      "name": "Ответ Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1550, 600]
    }
  ],
