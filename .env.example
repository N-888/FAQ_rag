# Переменные окружения для работы с GigaChat и Qdrant
# Скопируйте этот файл в .env и заполните реальными значениями

# Ключ авторизации GigaChat (получите на developers.sber.ru)
GIGACHAT_AUTH_KEY=your_gigachat_auth_key_here

# Адрес кластера Qdrant (без https://)
QDRANT_ENDPOINT=your_qdrant_endpoint_here

# Название коллекции в Qdrant
QDRANT_COLLECTION=faq_documents

# API-ключ Qdrant (получите в интерфейсе Qdrant)
QDRANT_API_KEY=your_qdrant_api_key_here
